{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-dot-bridge",
  "main": "build/index.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "build": {
    "command": "bash scripts/build-rust.sh"
  },
  "vars": {
    "ACCEPT_TASKS": "false",
    "MCP_ENABLED": "false",
    "LEGACY_HTTP_ENABLED": "false",
    "MCP_EVENTS_ENABLED": "false",
    "EVENTS_TRANSPORT_VERIFIED": "false"
  },
  "observability": {
    "enabled": false
  },
  "preview_urls": false,
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
